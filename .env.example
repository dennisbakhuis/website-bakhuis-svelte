# ============================================================
# dennisbakhuis.nl — environment variables
# Copy this file to .env. The defaults work for local development
# with `make run` (Postgres + backend + Mailpit in docker compose,
# SvelteKit dev server on the host).
# ============================================================

# ------------------------------------------------------------
# Frontend (SvelteKit)
# ------------------------------------------------------------
# Drives canonical URLs and the production fail-closed guard for Cap.
PUBLIC_SITE_URL=http://localhost:5373

# Where the SvelteKit *server* reaches the FastAPI backend. The browser
# never uses this: it talks to /api/* on the site origin, which the Vite
# dev server (dev) or Caddy (prod) proxies to the backend.
BACKEND_URL=http://localhost:8300

# Cap (self-hosted proof-of-work CAPTCHA on the contact form).
# REQUIRED in production. CAP_SECRET ≥16 bytes: `openssl rand -hex 32`.
CAP_ENABLED=false
CAP_SECRET=
PUBLIC_CAP_ENABLED=false
PUBLIC_CAP_API_ENDPOINT=/api/cap/

# SMTP for the contact form (frontend sends directly). In dev this points
# at Mailpit (http://localhost:8325).
SMTP_HOST=localhost
SMTP_PORT=1325
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=website@example.org
SMTP_TO_EMAIL=owner@example.org

# Umami analytics — server-side relay. Leave empty to disable.
UMAMI_API_URL=
UMAMI_WEBSITE_ID=
UMAMI_TIMEOUT_MS=5000

# ------------------------------------------------------------
# Backend (FastAPI) — read by docker-compose.yml
# ------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://bakhuis:bakhuis@db:5432/bakhuis
# Only this address can log in to /admin. A magic link is mailed to it.
OWNER_EMAIL=owner@example.org
# Signs session cookies and magic-link tokens: `openssl rand -hex 32`.
SESSION_SECRET=dev-only-session-secret-change-me-please
# Public origin of the site, used in magic-link e-mails.
SITE_URL=http://localhost:5373
# Cookie `Secure` flag; must be true behind TLS in production.
COOKIE_SECURE=false
# local = files under MEDIA_ROOT (dev); s3 = Hetzner Object Storage (prod).
STORAGE_BACKEND=local
MEDIA_ROOT=/data/media
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=fsn1
# Backend SMTP for magic links (Mailpit in dev).
BACKEND_SMTP_HOST=mailpit
BACKEND_SMTP_PORT=1025
BACKEND_SMTP_USERNAME=
BACKEND_SMTP_PASSWORD=
BACKEND_SMTP_TLS=false
BACKEND_SMTP_FROM=login@example.org
# Seed the sample dive log when the database is empty (dev only).
SEED_ON_EMPTY=true
