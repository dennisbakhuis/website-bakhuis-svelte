# ============================================================
# dennisbakhuis.nl — environment variables
# Copy this file to .env. The defaults work for local development
# with `make run` (backend + Mailpit in docker compose,
# SvelteKit dev server on the host).
# ============================================================

# ------------------------------------------------------------
# Frontend (SvelteKit)
# ------------------------------------------------------------
# Drives canonical URLs and the production fail-closed guard for Cap.
PUBLIC_SITE_URL=http://localhost:5373

# Where the SvelteKit *server* reaches the divelog-server backend. The browser
# never uses this: it talks to /api/* on the site origin, which the Vite
# dev server (dev) or Caddy (prod) proxies to the backend.
BACKEND_URL=http://localhost:8300

# Cap (self-hosted proof-of-work CAPTCHA on the contact form).
# REQUIRED in production. CAP_SECRET ≥16 bytes: `openssl rand -hex 32`.
CAP_ENABLED=false
CAP_SECRET=
PUBLIC_CAP_ENABLED=false
PUBLIC_CAP_API_ENDPOINT=/api/cap/

# SMTP for the contact form (frontend sends directly). In dev this points
# at Mailpit (http://localhost:8325).
SMTP_HOST=localhost
SMTP_PORT=1325
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=website@example.org
SMTP_TO_EMAIL=owner@example.org

# Umami analytics — server-side relay. Leave empty to disable.
UMAMI_API_URL=
UMAMI_WEBSITE_ID=
UMAMI_TIMEOUT_MS=5000

# ------------------------------------------------------------
# Backend (divelog-server) — read by docker-compose.yml
# ------------------------------------------------------------
# The server package in a checkout of the divelog monorepo; compose builds
# its `dev` image from here and mounts the source for --reload.
DIVELOG_SERVER_DIR=../divelog/packages/server
# The package's defaults are generic; compose sets this site's values
# (SITE_NAME … S3_REGION below) explicitly and these lines override them.
# The dive log lives as files in a checkout of the private divelog-data repo.
# docker-compose mounts DATA_REPO at DATA_ROOT; sessions live in STATE_DIR.
DATA_REPO=../divelog-data
# Checkout of the shared dive-site commons (divelog-sites). docker-compose
# mounts COMMONS_REPO read-only at /data/commons and sets COMMONS_ROOT to it.
# Outside compose, COMMONS_ROOT names the checkout directly; empty = the path
# in the log's divelog.yaml, and no commons when that names none.
COMMONS_REPO=../divelog-sites
COMMONS_ROOT=
# Pull the commons checkout from its remote on reload (prod).
COMMONS_GIT_ENABLED=false
# Photos, scans and avatars in dev; S3 in prod (STORAGE_BACKEND below).
MEDIA_DIR=../divelog-media
DATA_ROOT=/data/repo
STATE_DIR=/data/state
# Commit every admin edit and push it to the data repo's remote (prod). In
# dev the checkout is your own working copy, so leave this off.
GIT_ENABLED=false
GIT_AUTHOR_NAME=Dennis Bakhuis
GIT_AUTHOR_EMAIL=
GIT_SSH_KEY_PATH=/run/secrets/deploy_key
# Branding: API title, magic-link mail and the countries that are home
# (dives there never form a trip). {site_name} and {owner_name} are filled in.
SITE_NAME=dennisbakhuis.nl
OWNER_NAME=Dennis
HOME_COUNTRIES=NLD,DEU,BEL
MAIL_SUBJECT=Sign in to {site_name}
MAIL_GREETING=Hi {owner_name},
# Only this address can log in to /admin. A magic link is mailed to it.
OWNER_EMAIL=owner@example.org
# Signs session cookies and magic-link tokens: `openssl rand -hex 32`.
SESSION_SECRET=dev-only-session-secret-change-me-please
SESSION_COOKIE_NAME=bakhuis_session
# Public origin of the site, used in magic-link e-mails.
SITE_URL=http://localhost:5373
# Cookie `Secure` flag; must be true behind TLS in production.
COOKIE_SECURE=false
# local = files under MEDIA_ROOT (dev); s3 = Hetzner Object Storage (prod).
STORAGE_BACKEND=local
MEDIA_ROOT=/data/media
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=fsn1
# Backend SMTP for magic links (Mailpit in dev).
BACKEND_SMTP_HOST=mailpit
BACKEND_SMTP_PORT=1025
BACKEND_SMTP_USERNAME=
BACKEND_SMTP_PASSWORD=
BACKEND_SMTP_TLS=false
BACKEND_SMTP_FROM=login@example.org
