# Secrets — never ship into the build context
.env
.env.*
!.env.example

# Git metadata
.git
.gitignore
.github

# Local dev / build artifacts (rebuilt inside the container)
node_modules
build
.svelte-kit
coverage

# Python site tools (scripts/ and the uv project) are not part of the frontend
.venv
pyproject.toml
uv.lock
scripts/*.py

# Editor / OS
.vscode
.idea
.DS_Store
local
.claude

# Docs
docs
*.md
!README.md

# The content repository's CI checkout; the posts arrive as the `content` build context
website-bakhuis-content

# Misc
.prettier*
.editorconfig
.pre-commit-config.yaml
Dockerfile
docker-compose.yml
Makefile
data/
